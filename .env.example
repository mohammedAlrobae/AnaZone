# ========================================================
# AnaZone Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NOTE: Never commit your actual .env file or sensitive keys!
# ========================================================

# Cloudflare Workers AI (STT - Whisper Large v3 Turbo)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Hugging Face (Optional / if downloading or accessing private spaces)
HF_TOKEN=your_huggingface_token_here

# LLM Inference API
LLM_API_URL=http://127.0.0.1:4000/v1/chat/completions
LLM_MODEL=claude-sonnet-9
LLM_API_KEY=

# ElevenLabs (Optional / fallback)
ELEVENLABS_API_KEY=
