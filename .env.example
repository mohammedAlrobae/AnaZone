# ==============================================================================
# AnaZone Environment Configuration (.env.example)
# Duplicate this file as .env and fill in your real credentials before running.
# ==============================================================================

# 1. Cloudflare Workers AI (Speech-to-Text via Whisper Turbo)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo

# 2. Groq Cloud (LLM Reasoning & Agent Graph)
# Supports 'openai/gpt-oss-120b' and fallback 'qwen/qwen3.8-27b'
cloud_groq_api=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

# 3. Hugging Face & VoiceTut-TTS Configuration
HF_TOKEN=your_huggingface_user_access_token_here

# 4. News & Live Information
NEWSAPIKEY=your_newsdata_io_api_key_here

# 5. Frontend & Mapping (Used in Next.js / Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
